# Copy to .env and fill in. Never commit real values.
# In Vercel, set the same names under Project → Settings → Environment Variables.

NEXT_PUBLIC_API_URL=https://backend.sparemicro.com/api/
NEXT_PUBLIC_SITE_URL=https://new-town-spares.vercel.app
NEXT_PUBLIC_STORE_ID=4
NEXT_PUBLIC_STORE_HASH=
NEXT_PUBLIC_CHARGE_IN_SELECTED_CURRENCY=true

# reCAPTCHA (https://www.google.com/recaptcha/admin)
NEXT_PUBLIC_RECAPTCHA_SITE_KEY=
# Server-only — no NEXT_PUBLIC_ prefix, never exposed to the browser.
RECAPTCHA_SECRET_KEY=

# Stripe publishable key (pk_test_… for dev, pk_live_… for production)
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=

# GeoNames account for postcode lookup (https://www.geonames.org/login). Server-only.
GEONAMES_USERNAME=
